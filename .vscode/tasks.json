{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "mainブランチをPull",
			"type": "shell",
			"command": "git checkout main && git pull",
			"problemMatcher": []
		},
		{
			"label": "現在ブランチをPull",
			"type": "shell",
			"command": "git pull",
			"problemMatcher": []
		},
		{
			"label": "mainブランチから新規ブランチ作成",
			"type": "shell",
			"command": "git checkout main && git pull && git checkout -b ${input:branch}",
			"problemMatcher": []
		},
		{
			"label": "git commit (変更をコミットしてプッシュできる状態にします)",
			"type": "shell",
			"command": "git add . && git commit -m \"${input:message}\"",
			"problemMatcher": []
		},
		{
			"label": "git push (現在ブランチをプッシュします。未コミットがないか確認すること。)",
			"type": "shell",
			"command": "git push -u origin HEAD",
			"problemMatcher": []
		},
		{
			"label": "Python仮想環境を作成して依存をインストール",
			"type": "shell",
			"command": "python -m venv .venv && .venv\\Scripts\\pip install -r requirements.txt",
			"problemMatcher": []
		},
		{
			"label": "DBを再生成",
			"type": "shell",
			"command": ".venv\\Scripts\\python.exe scripts/build_db.py",
			"problemMatcher": []
		},
		{
			"label": "MkDocsビルド",
			"type": "shell",
			"command": ".venv\\Scripts\\mkdocs.exe build",
			"problemMatcher": []
		},
		{
			"label": "MkDocsプレビュー",
			"type": "shell",
			"command": ".venv\\Scripts\\mkdocs.exe serve",
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Go mod tidy (sim)",
			"type": "shell",
			"command": "go mod tidy",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Goテスト (sim)",
			"type": "shell",
			"command": "go test ./...",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			},
			"problemMatcher": []
		},
		{
			"label": "Goビルド (sim)",
			"type": "shell",
			"command": "go build -o sim/bin/sim.exe ./sim/",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"type": "promptString",
			"id": "message",
			"description": "コミット変更内容を入力してください。",
			"default": ""
		},
		{
			"type": "promptString",
			"id": "branch",
			"description": "ブランチ名を入力してください。",
			"default": ""
		}
	]
}
