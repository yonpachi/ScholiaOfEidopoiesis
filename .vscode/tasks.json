{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "mainブランチをPull",
			"type": "shell",
			"command": "git checkout main && git pull",
			"problemMatcher": []
		},
		{
			"label": "現在ブランチをPull",
			"type": "shell",
			"command": "git pull",
			"problemMatcher": []
		},
		{
			"label": "mainブランチから新規ブランチ作成",
			"type": "shell",
			"command": "git checkout main && git pull && git checkout -b ${input:branch}",
			"problemMatcher": []
		},
		{
			"label": "git commit (変更をコミットしてプッシュできる状態にします)",
			"type": "shell",
			"command": "git add . && git commit -m \"${input:message}\"",
			"problemMatcher": []
		},
		{
			"label": "git push (現在ブランチをプッシュします。未コミットがないか確認すること。)",
			"type": "shell",
			"command": "git push -u origin HEAD",
			"problemMatcher": []
		},
		{
			"label": "Python仮想環境を作成して依存をインストール",
			"type": "shell",
			"command": "python -m venv .venv && .venv\\Scripts\\pip install -r requirements.txt",
			"problemMatcher": []
		},
		{
			"label": "DBを再生成",
			"type": "shell",
			"command": ".venv\\Scripts\\python.exe scripts/build_db.py",
			"problemMatcher": []
		},
		{
			"label": "MkDocsビルド",
			"type": "shell",
			"command": ".venv\\Scripts\\mkdocs.exe build",
			"problemMatcher": []
		},
		{
			"label": "MkDocsプレビュー",
			"type": "shell",
			"command": ".venv\\Scripts\\mkdocs.exe serve",
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Go mod tidy (sim)",
			"type": "shell",
			"command": "go mod tidy",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Goテスト (sim)",
			"type": "shell",
			"command": "go test ./...",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			},
			"problemMatcher": []
		},
		{
			"label": "Goビルド (sim)",
			"type": "shell",
			"command": "go build -o sim/bin/sim.exe ./sim/ && go build -o sim/bin/part1.exe ./sim/part1 && go build -o sim/bin/part2.exe ./sim/part2 && go build -o sim/bin/part3.exe ./sim/part3",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Part1限界貢献度",
			"type": "shell",
			"command": ".venv\\Scripts\\python.exe sim/part1/run.py",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Part2種族能力",
			"type": "shell",
			"command": ".venv\\Scripts\\python.exe sim/part2/run.py",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Part3種族平均スコア",
			"type": "shell",
			"command": ".venv\\Scripts\\python.exe sim/part3/run.py",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Goフォーマット",
			"type": "shell",
			"command": "${env:USERPROFILE}\\go\\bin\\goimports.exe -w pkg sim",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Pythonフォーマット",
			"type": "shell",
			"command": ".venv\\Scripts\\ruff.exe format .",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "全コードフォーマット",
			"type": "shell",
			"command": "${env:USERPROFILE}\\go\\bin\\goimports.exe -w pkg sim && .venv\\Scripts\\ruff.exe format .",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Goリント",
			"type": "shell",
			"command": "${env:USERPROFILE}\\go\\bin\\golangci-lint.exe run ./...",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Pythonリント",
			"type": "shell",
			"command": ".venv\\Scripts\\ruff.exe check .",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "全コードリント",
			"type": "shell",
			"command": "${env:USERPROFILE}\\go\\bin\\golangci-lint.exe run ./... && .venv\\Scripts\\ruff.exe check .",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "全てをチェック(Go)",
			"type": "shell",
			"command": "${env:USERPROFILE}\\go\\bin\\goimports.exe -w pkg sim && ${env:USERPROFILE}\\go\\bin\\golangci-lint.exe run ./... && go mod tidy && go test ./... && go build -o sim/bin/sim.exe ./sim/ && go build -o sim/bin/part1.exe ./sim/part1 && go build -o sim/bin/part2.exe ./sim/part2 && go build -o sim/bin/part3.exe ./sim/part3",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "全てをチェック(python)",
			"type": "shell",
			"command": ".venv\\Scripts\\ruff.exe format . && .venv\\Scripts\\ruff.exe check .",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "全てをチェック",
			"type": "shell",
			"command": "${env:USERPROFILE}\\go\\bin\\goimports.exe -w pkg sim && ${env:USERPROFILE}\\go\\bin\\golangci-lint.exe run ./... && go mod tidy && go test ./... && go build -o sim/bin/sim.exe ./sim/ && .venv\\Scripts\\ruff.exe format . && .venv\\Scripts\\ruff.exe check .",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"type": "promptString",
			"id": "message",
			"description": "コミット変更内容を入力してください。",
			"default": ""
		},
		{
			"type": "promptString",
			"id": "branch",
			"description": "ブランチ名を入力してください。",
			"default": ""
		}
	]
}
