{
	"[go]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "golang.go",
		"editor.codeActionsOnSave": {
			"source.organizeImports": "explicit"
		}
	},
	"go.formatTool": "goimports",
	"go.lintOnSave": "package",
	"[python]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.codeActionsOnSave": {
			"source.fixAll.ruff": "explicit",
			"source.organizeImports.ruff": "explicit"
		}
	},
	"ruff.configuration": "${workspaceFolder}/pyproject.toml",
	"ruff.lint.run": "onSave",
	"commands.workspaceCommands": {
		"Github支援系": {
			"nestedItems": {
				"MainブランチをPullする": {
					"command": "workbench.action.tasks.runTask",
					"args": "mainブランチをPull"
				},
				"現在ブランチをPullする": {
					"command": "workbench.action.tasks.runTask",
					"args": "現在ブランチをPull"
				},
				"mainブランチから新規ブランチ作成": {
					"command": "workbench.action.tasks.runTask",
					"args": "mainブランチから新規ブランチ作成"
				},
				"git commit (変更をコミットしてプッシュできる状態にします)": {
					"command": "workbench.action.tasks.runTask",
					"args": "git commit (変更をコミットしてプッシュできる状態にします)"
				},
				"git push (現在ブランチをプッシュします。未コミットがないか確認すること。)": {
					"command": "workbench.action.tasks.runTask",
					"args": "git push (現在ブランチをプッシュします。未コミットがないか確認すること。)"
				}
			}
		},
		"セットアップ": {
			"nestedItems": {
				"Python仮想環境を作成して依存をインストール": {
					"command": "workbench.action.tasks.runTask",
					"args": "Python仮想環境を作成して依存をインストール"
				}
			}
		},
		"データベース": {
			"nestedItems": {
				"DBを再生成": {
					"command": "workbench.action.tasks.runTask",
					"args": "DBを再生成"
				}
			}
		},
		"ドキュメント": {
			"nestedItems": {
				"MkDocsビルド": {
					"command": "workbench.action.tasks.runTask",
					"args": "MkDocsビルド"
				},
				"MkDocsプレビュー": {
					"command": "workbench.action.tasks.runTask",
					"args": "MkDocsプレビュー"
				}
			}
		},
		"エミュレーター": {
			"nestedItems": {
				"Go mod tidy (sim)": {
					"command": "workbench.action.tasks.runTask",
					"args": "Go mod tidy (sim)"
				},
				"Goテスト (sim)": {
					"command": "workbench.action.tasks.runTask",
					"args": "Goテスト (sim)"
				},
				"Goビルド (sim)": {
					"command": "workbench.action.tasks.runTask",
					"args": "Goビルド (sim)"
				},
				"Part1限界貢献度": {
					"command": "workbench.action.tasks.runTask",
					"args": "Part1限界貢献度"
				},
				"Part2種族能力": {
					"command": "workbench.action.tasks.runTask",
					"args": "Part2種族能力"
				}
			}
		},
		"コード品質": {
			"nestedItems": {
				"Goフォーマット": {
					"command": "workbench.action.tasks.runTask",
					"args": "Goフォーマット"
				},
				"Pythonフォーマット": {
					"command": "workbench.action.tasks.runTask",
					"args": "Pythonフォーマット"
				},
				"全コードフォーマット": {
					"command": "workbench.action.tasks.runTask",
					"args": "全コードフォーマット"
				},
				"Goリント": {
					"command": "workbench.action.tasks.runTask",
					"args": "Goリント"
				},
				"Pythonリント": {
					"command": "workbench.action.tasks.runTask",
					"args": "Pythonリント"
				},
				"全コードリント": {
					"command": "workbench.action.tasks.runTask",
					"args": "全コードリント"
				},
				"全てをチェック(Go)": {
					"command": "workbench.action.tasks.runTask",
					"args": "全てをチェック(Go)"
				},
				"全てをチェック(python)": {
					"command": "workbench.action.tasks.runTask",
					"args": "全てをチェック(python)"
				},
				"全てをチェック": {
					"command": "workbench.action.tasks.runTask",
					"args": "全てをチェック"
				}
			}
		}
	}
}
