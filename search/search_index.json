{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u932c\u91d1TRPG\u300c\u60f3\u6210\u306e\u30b9\u30b3\u30fc\u30ea\u30a2\u300d","text":""},{"location":"#trpg","title":"\u932c\u91d1TRPG\u300c\u60f3\u6210\u306e\u30b9\u30b3\u30fc\u30ea\u30a2\u300d","text":"<p>\u8857\u3068\u5de5\u623f\u3092\u62e0\u70b9\u306b\u3001\u9727\u57df\u3092\u62d3\u304d\u3001\u932c\u91d1\u3068\u63a2\u7d22\u3092\u91cd\u306d\u308bTRPG</p>"},{"location":"#_1","title":"\u60f3\u5b9a\u4eba\u6570","text":"\uff27\uff2d\uff11\u4eba\u3001\uff30\uff2c\uff13\uff5e\uff15\u4eba"},{"location":"#_2","title":"\u5fc5\u8981\u306a\u3082\u306e","text":"\u30c0\u30a4\u30b9\uff08\uff24\uff14,\uff16,\uff18,\uff11\uff10,\uff11\uff12,\uff12\uff10\uff09\u3044\u304f\u3064\u304b \u30c8\u30e9\u30f3\u30d7\uff11\u30c7\u30c3\u30ad"},{"location":"#_3","title":"\u30bb\u30c3\u30b7\u30e7\u30f3\u6642\u9593","text":"\uff11\u30bb\u30c3\u30b7\u30e7\u30f3\uff13\uff10\u5206\uff5e\uff12\u6642\u9593 <p>\u672a\u3060\u8a18\u3055\u308c\u306c\u5730\u304c\u3042\u308b</p> <p>\u672a\u3060\u660e\u304b\u3055\u308c\u306c\u77e5\u304c\u3042\u308b</p> <p>\u672a\u3060\u6975\u3081\u3089\u308c\u306c\u7dfb\u304c\u3042\u308b</p> <p>\u305d\u306e\u5168\u3066\u3092\u6c42\u3081\u3066\u4eca\u65e5\u3082\u51fa\u304b\u3051\u308b</p> <p></p>"},{"location":"about/","title":"\u306f\u3058\u3081\u306b","text":""},{"location":"about/#trpg","title":"\u3069\u3093\u306aTRPG\u306a\u306e\uff1f","text":"<p>\u8857\u3068\u5de5\u623f\u3092\u62e0\u70b9\u306b\u3001\u65e5\u3005\u63a2\u7d22\u3068\u932c\u91d1\u3092\u7a4d\u307f\u91cd\u306d\u3001\u65b0\u305f\u306a\u5730\u666f\u3092\u5207\u308a\u62d3\u304fTRPG\u3067\u3059\u3002</p>"},{"location":"about/#_1","title":"\u3069\u3093\u306a\u4e16\u754c\u306a\u306e\uff1f","text":"<p>\u3053\u306e\u4e16\u754c\u306b\u306f\u672a\u3060\u4eba\u3005\u304c\u8e0f\u307f\u5165\u308c\u305f\u3053\u3068\u304c\u306a\u3044\u3001\u9727\u57df\u3068\u547c\u3070\u308c\u308b\u5834\u6240\u304c\u5b58\u5728\u3057\u307e\u3059\u3002</p> <p>\u305d\u3053\u3067\u306f\u9053\u3082\u666f\u8272\u3082\u308f\u304b\u3089\u305a\u3001\u305f\u3060\u5411\u304b\u3063\u305f\u3060\u3051\u3067\u306f\u540c\u3058\u5834\u6240\u306b\u8fbf\u308a\u7740\u304f\u3053\u3068\u3082\u3067\u304d\u307e\u305b\u3093\u3002</p> <p>\u3057\u304b\u3057\u7e70\u308a\u8fd4\u3057\u63a2\u7d22\u3092\u884c\u3046\u3068\u3001\u30b9\u30b3\u30fc\u30ea\u30aa\u30f3\u3068\u547c\u3070\u308c\u308b\u907a\u7269\u304c\u6642\u6298\u898b\u3064\u304b\u308a\u307e\u3059\u3002</p> <p>\u305d\u308c\u3092\u754c\u6a19\u3068\u3057\u3066\u636e\u3048\u308b\u3053\u3068\u3067\u9727\u304c\u6674\u308c\u3001\u5730\u666f\u304c\u62d3\u304b\u308c\u307e\u3059\u3002</p>"},{"location":"about/#_2","title":"\u3042\u306a\u305f\u306f\u8ab0\u306a\u306e\uff1f","text":"<p>\u3042\u306a\u305f\u306f\u9727\u57df\u958b\u62d3\u306e\u6700\u524d\u7dda\u306b\u3042\u308b\u8857\u306e\u4f4f\u4eba\u3067\u3059\u3002</p> <p>\u3042\u306a\u305f\u306f\u4f55\u4eba\u304b\u306e\u4ef2\u9593\u3068\u3001\u5de5\u623f\u3092\u55b6\u3093\u3067\u3044\u307e\u3059\u3002</p> <p>\u3042\u306a\u305f\u306f\u9727\u57df\u306e\u958b\u62d3\u8005\u3067\u3042\u308a\u3001\u5730\u666f\u306e\u63a2\u7d22\u8005\u3067\u3042\u308a\u3001\u4e00\u7aef\u306e\u932c\u91d1\u8853\u5e2b\u3067\u3042\u308a\u3001\u3053\u306e\u8857\u306e\u66ae\u3089\u3057\u3092\u652f\u3048\u308b\u8077\u4eba\u3067\u3082\u3042\u308a\u307e\u3059\u3002</p>"},{"location":"about/#_3","title":"\u3069\u306e\u3088\u3046\u306b\u66ae\u3089\u3057\u3066\u3044\u308b\u306e\uff1f","text":"<p>\u3042\u306a\u305f\u306f\u57fa\u672c\u7684\u306b</p> <ul> <li>\u8857\u3084\u5de5\u623f\u3067\u6e96\u5099\u3092\u3059\u308b</li> <li>\u9727\u57df\u3084\u5730\u666f\u3078\u63a2\u7d22\u306b\u51fa\u308b</li> <li>\u7d20\u6750\u3092\u6301\u3061\u5e30\u308b</li> <li>\u5206\u89e3\u3057\u3066\u30de\u30ca\u3092\u5f97\u308b</li> <li>\u30a2\u30a4\u30c6\u30e0\u3092\u4f5c\u308b</li> <li>\u4f9d\u983c\u3084\u7d0d\u54c1\u3092\u9054\u6210\u3059\u308b</li> </ul> <p>\u3068\u3044\u3063\u305f\u6d41\u308c\u3067\u65e5\u3005\u3092\u66ae\u3089\u3057\u3066\u3044\u307e\u3059\u3002</p> <p>\u305d\u306e\u6d41\u308c\u304b\u3089\u5916\u308c\u3066\u81ea\u7531\u306b\u904e\u3054\u3059\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002</p> <p>\u3057\u304b\u3057\u3042\u307e\u308a\u6020\u3051\u3066\u3044\u308b\u3068\u4eba\u3005\u306e\u4fe1\u983c\u3092\u5931\u3044\u307e\u3059\u3002</p> <p>\u9069\u5ea6\u306b\u50cd\u304d\u3001\u4f11\u307f\u3001\u4ea4\u6d41\u3057\u3001\u8857\u306e\u4f4f\u4eba\u3068\u3057\u3066\u66ae\u3089\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"about/#_4","title":"\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u306e\uff1f","text":"<p>\u932c\u91d1\u8853\u3092\u6975\u3081\u3066\u3082\u3044\u3044\u3067\u3059\u3057</p> <p>\u5de5\u623f\u3092\u5927\u304d\u304f\u3057\u3066\u3082\u3044\u3044\u3067\u3059\u3057</p> <p>\u8857\u306e\u767a\u5c55\u306b\u5c3d\u529b\u3057\u3066\u3082\u3044\u3044\u3067\u3059\u3057</p> <p>\u4eba\u3005\u3068\u4ef2\u826f\u304f\u697d\u3057\u304f\u751f\u304d\u3066\u3044\u3066\u3082\u3044\u3044\u3067\u3059\u3057</p> <p>\u4e16\u754c\u306e\u771f\u7406\u3092\u63a2\u6c42\u3057\u3066\u3082\u3044\u3044\u3067\u3059\u3002</p>"},{"location":"glossary/","title":"\u7528\u8a9e\u96c6","text":""},{"location":"glossary/#_1","title":"\u7528\u8a9e\u96c6","text":"<p>\u30b2\u30fc\u30e0\u5185\u3067\u4f7f\u3046\u7528\u8a9e\u3092\u3053\u3053\u306b\u5b9a\u7fa9\u3057\u307e\u3059\u3002\u8868\u8a18\u306e\u63fa\u308c\u3092\u9632\u3050\u305f\u3081\u3001\u30eb\u30fc\u30eb\u6587\u66f8\u3067\u306f\u3053\u306e\u30da\u30fc\u30b8\u306e\u7528\u8a9e\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p> <p>\uff08\u6e96\u5099\u4e2d\uff09</p>"},{"location":"rules/ancestry/","title":"\u7a2e\u65cf","text":"<p>\u3053\u3053\u3067\u306f\u7a2e\u65cf\u3068\u305d\u306e\u80fd\u529b\u306b\u3064\u3044\u3066\u8aac\u660e\u3057\u307e\u3059\u3002\u5224\u5b9a\u6642\u80fd\u529b\u306f\u5224\u5b9a\u51e6\u7406\u306e\u9014\u4e2d\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002</p> <p>\u5404\u7a2e\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u3064\u3044\u3066\u306f \u5224\u5b9a \u306e\u9805\u76ee\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044</p> <p>\u3053\u306e\u4e16\u754c\u306b\u306f\u591a\u7a2e\u591a\u69d8\u306a\u4f4f\u4eba\u304c\u5b58\u5728\u3059\u308b\u3002</p> <p>\u3044\u308f\u3086\u308b\u4eba\u9593\u306f\u3082\u3061\u308d\u3093\u3001\u7363\u3084\u5e7d\u970a\u3082\u5f53\u305f\u308a\u524d\u306b\u3044\u308b\u3057\u3001\u77f3\u3067\u3042\u3063\u3066\u3082\u77e5\u80fd\u3092\u6709\u3057\u3066\u3044\u308b\u3053\u3068\u304c\u3042\u308b\u3002</p> <p>\u3053\u3053\u3067\u306f\u4e3b\u306b PC \u3068\u3057\u3066\u8a2d\u5b9a\u3067\u304d\u308b 6 \u3064\u306e\u7a2e\u65cf \u306b\u3064\u3044\u3066\u89e3\u8aac\u3059\u308b\u3002</p>"},{"location":"rules/ancestry/#_1","title":"\u6982\u8981","text":"<p>\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u4f5c\u6210\u6642\u306b \u7a2e\u65cf \u3092\u9078\u629e\u3059\u308b\u3002\u5404\u7a2e\u65cf\u306f \u5224\u5b9a\u6642\u80fd\u529b \u3068 \u6226\u95d8\u6642\u80fd\u529b \u3092\u6301\u3064\u3002</p> <ul> <li>\u5224\u5b9a\u6642\u80fd\u529b \u2014 1\u56de\u306e\u5224\u5b9a\u4e2d\u306b 1\u5ea6\u3060\u3051 \u4f7f\u7528\u53ef\u80fd</li> <li>\u6226\u95d8\u6642\u80fd\u529b \u2014 \u6226\u95d8\u4e2d\u3001\u6761\u4ef6\u3092\u6e80\u305f\u3057\u305f\u6642 \u306b\u4f7f\u7528\u53ef\u80fd</li> </ul>"},{"location":"rules/ancestry/#_2","title":"\u7a2e\u65cf\u4e00\u89a7","text":"\u7a2e\u65cf \u5224\u5b9a\u6642\u80fd\u529b \u6226\u95d8\u6642\u80fd\u529b \u4eba\u9593\uff08\u30d2\u30e5\u30fc\u30e0\uff09 \u7ffb\u8ee2 \u5f62\u52e2\u4e00\u5909 \u7363\u88d4\uff08\u30d9\u30b9\u30c6\u30a3\u30a2\uff09 \u8ee2\u6a5f \u732a\u7a81\u731b\u9032 \u6a5f\u5de7\uff08\u30de\u30ad\u30ca\uff09 \u7d20\u8aad \u660e\u93e1\u6b62\u6c34 \u932c\u751f\uff08\u30db\u30e0\u30f3\u30af\u30eb\u30b9\uff09 \u9069\u5fdc \u7aae\u4f59\u4e00\u7b56 \u4ed8\u55aa\uff08\u30ec\u30ea\u30ad\u30a2\uff09 \u624b\u99b4 \u7089\u706b\u7d14\u9752 \u534a\u970a\uff08\u30a6\u30f3\u30d6\u30e9\uff09 \u8d8a\u5883 \u66d6\u6627\u6a21\u7cca"},{"location":"rules/ancestry/#_3","title":"\u4eba\u9593\uff08\u30d2\u30e5\u30fc\u30e0\uff09","text":"<p>\u7279\u5fb4\u306e\u306a\u3044\u7a2e\u65cf\u3002\u5927\u5c0f\u69d8\u3005\u306a\u5f62\u3092\u3057\u3066\u3044\u308b\u304c\u3001\u5927\u3057\u305f\u9055\u3044\u306f\u306a\u3044\u3002</p> <p>\u306a\u3093\u3067\u3082\u306a\u3044\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u306a\u3093\u3068\u3067\u3082\u306a\u308b\u3068\u3044\u3046\u3053\u3068\u3060\u3002</p>"},{"location":"rules/ancestry/#_4","title":"\u5224\u5b9a\u6642\u80fd\u529b\uff1a\u7ffb\u8ee2","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u53cd\u5fdc\u4e2d</li> <li>\u30b3\u30b9\u30c8: \u9054\u6210\u5024\u304b\u3089\u767a\u52d5\u6642\u306e\u30c0\u30a4\u30b9\u306e\u500b\u6570\u5206\u3060\u3051\u5dee\u3057\u5f15\u304f</li> <li>\u52b9\u679c<ul> <li>\u672a\u53cd\u5fdc\u30c0\u30a4\u30b91\u3064\u3092\u5bfe\u8c61\u306b\u3059\u308b</li> <li>\u5bfe\u8c61\u306e\u51fa\u76ee\u3092\u88cf\u8fd4\u3059</li> <li>\u5bfe\u8c61\u3092\u53cd\u5fdc\u6e08\u307f\u306b\u3059\u308b</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_5","title":"\u6226\u95d8\u6642\u80fd\u529b\uff1a\u5f62\u52e2\u4e00\u5909","text":"<ul> <li>\u4f7f\u7528\u56de\u6570: \u6226\u95d8\u4e2d1\u56de</li> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u6226\u95d8\u4e2d\u306e\u4efb\u610f\u306e\u30bf\u30a4\u30df\u30f3\u30b0</li> <li>\u52b9\u679c<ul> <li>\u5c71\u672d\u304b\u3089\u30ab\u30fc\u30c9\u30921\u679a\u5f15\u304d\u3001\u305d\u306e\u5f8c\u624b\u672d\u30921\u679a\u6368\u3066\u308b</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_6","title":"\u7363\u88d4\uff08\u30d9\u30b9\u30c6\u30a3\u30a2\uff09","text":"<p>\u3075\u308f\u3075\u308f\u3054\u308f\u3054\u308f\u3057\u305f\u7a2e\u65cf\u3002\u305d\u306e\u8033\u3068\u5c3b\u5c3e\u3067\u597d\u6a5f\u3092\u9003\u3055\u306a\u3044\u3002</p> <p>\u9f3b\u3082\u52b9\u304f\u304c\u3001\u8179\u306f\u898b\u305b\u306a\u3044\u3053\u3068\u3060\u3002</p>"},{"location":"rules/ancestry/#_7","title":"\u5224\u5b9a\u6642\u80fd\u529b\uff1a\u8ee2\u6a5f","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u53cd\u5fdc\u4e2d</li> <li>\u52b9\u679c<ul> <li>\u30c0\u30a4\u30b91\u3064\u3092\u5bfe\u8c61\u306b\u3059\u308b\u3002\u5bfe\u8c61\u3092\u632f\u308a\u76f4\u3059</li> <li>\u65b0\u3057\u3044\u51fa\u76ee\u304c\u5143\u3088\u308a \u5c0f\u3055\u3044 \u5834\u5408\u3001\u51fa\u76ee\u3092 1 \u306b\u3059\u308b</li> <li>\u305d\u308c\u4ee5\u5916\u306f\u65b0\u3057\u3044\u51fa\u76ee\u3092\u63a1\u7528\u3059\u308b</li> <li>\u632f\u308a\u76f4\u3057\u5f8c\u3001\u5bfe\u8c61\u306f \u672a\u53cd\u5fdc \u306b\u306a\u308b</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_8","title":"\u6226\u95d8\u6642\u80fd\u529b\uff1a\u732a\u7a81\u731b\u9032","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u81ea\u5206\u306e\u653b\u6483\u3067\u30ce\u30c3\u30af\u30d0\u30c3\u30af\u304c\u767a\u751f\u3057\u305f\u6642</li> <li>\u52b9\u679c<ul> <li>\u30ce\u30c3\u30af\u30d0\u30c3\u30af\u306e\u5024\u30921\u5927\u304d\u3044\u3082\u306e\u3068\u3057\u3066\u6271\u3046</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_9","title":"\u6a5f\u5de7\uff08\u30de\u30ad\u30ca\uff09","text":"<p>\u4eba\u306b\u3088\u3063\u3066\u9020\u3089\u308c\u305f\u7a2e\u65cf\u3002\u5f62\u72b6\u304c\u4eba\u3068\u306f\u9650\u3089\u306a\u3044\u304c\u3001\u610f\u8b58\u3068\u547c\u3079\u308b\u3082\u306e\u306f\u3042\u308b\u3089\u3057\u3044\u3002</p> <p>\u81ea\u6211\u306f\u8584\u3044\u304c\u3001\u305d\u306e\u65b9\u304c\u3044\u3044\u3053\u3068\u3082\u3042\u308b\u3002</p>"},{"location":"rules/ancestry/#_10","title":"\u5224\u5b9a\u6642\u80fd\u529b\uff1a\u7d20\u8aad","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u30c0\u30a4\u30b9\u30ed\u30fc\u30eb\u524d</li> <li>\u52b9\u679c<ul> <li>\u30d7\u30fc\u30eb\u5185 \u30d9\u30fc\u30b9 d10 \u3092 d12 \u306b\u63db\u88c5 \u3057\u3066\u30ed\u30fc\u30eb\u3059\u308b\uff08d10 \u304c\u7121\u3044\u5834\u5408\u306f\u4f7f\u7528\u4e0d\u53ef\uff09</li> <li>\u3053\u306e\u5224\u5b9a\u3067\u306f \u6fb1\u307f\u304c\u767a\u751f\u3057\u306a\u3044\uff08\u51fa\u76ee 1 \u3082 1 \u3068\u3057\u3066\u8aad\u3080\uff09</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_11","title":"\u6226\u95d8\u6642\u80fd\u529b\uff1a\u660e\u93e1\u6b62\u6c34","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u60f3\u6210\u4f7f\u7528\u6642</li> <li>\u52b9\u679c<ul> <li>\u30d7\u30ec\u30a4\u3057\u305f\u30ab\u30fc\u30c9\u306e\u30b9\u30fc\u30c8\u306b\u3088\u308b\u30de\u30ca\u30dc\u30fc\u30ca\u30b9\u306e\u5024\u30921\u5897\u52a0\u3059\u308b</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_12","title":"\u932c\u751f\uff08\u30db\u30e0\u30f3\u30af\u30eb\u30b9\uff09","text":"<p>\u4eba\u306b\u3088\u3063\u3066\u7523\u307e\u308c\u305f\u7a2e\u65cf\u3002\u5f62\u72b6\u306f\u4eba\u306b\u8fd1\u3044\u304c\u3001\u4e00\u90e8\u304c\u3075\u306b\u3083\u3075\u306b\u3083\u3060\u3063\u305f\u308a\u3001\u878d\u3051\u3066\u305f\u308a\u3059\u308b\u3002</p> <p>\u51fa\u6765\u4e0a\u304c\u3063\u3066\u3044\u306a\u3044\u304b\u3089\u3001\u6c7a\u307e\u3063\u3066\u3044\u306a\u3044\u306e\u3060\u3002</p>"},{"location":"rules/ancestry/#_13","title":"\u5224\u5b9a\u6642\u80fd\u529b\uff1a\u9069\u5fdc","text":"<p>1\u56de\u306e\u5224\u5b9a\u306e\u4e2d\u3067\u3001\u6b21\u306e 3\u3064\u304b\u30891\u3064\u3060\u3051 \u4f7f\u7528\u3067\u304d\u308b\u3002</p>"},{"location":"rules/ancestry/#_14","title":"\u4fee\u6b63","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u6fb1\u307f\u767a\u751f\u524d</li> <li>\u52b9\u679c<ul> <li>\u6b21\u306e \u6fb1\u307f\u767a\u751f \u3092 \u30b9\u30ad\u30c3\u30d7 \u3059\u308b</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_15","title":"\u767a\u73fe","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u9054\u6210\u5024\u6c7a\u5b9a</li> <li>\u52b9\u679c<ul> <li>\u53cd\u5fdc\u6e08\u307f\u30c0\u30a4\u30b9\u306e\u500b\u6570\u306e\u534a\u5206\uff08\u7aef\u6570\u5207\u308a\u6368\u3066\uff09\u3092\u3001\u9054\u6210\u5024\u306b\u52a0\u7b97\u3059\u308b</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_16","title":"\u53ce\u675f","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u53cd\u5fdc\u958b\u59cb\u524d</li> <li>\u52b9\u679c<ul> <li>\u30d7\u30fc\u30eb\u5185\u306e \u3059\u3079\u3066\u306e\u30c0\u30a4\u30b9 \u306e\u51fa\u76ee\u3092 \u9762\u6570\u00f72(\u7aef\u6570\u5207\u6368\u3066) \u306b\u305d\u308d\u3048\u308b</li> <li>\u305d\u306e\u5f8c \u53cd\u5fdc\u3082\u6fb1\u307f\u3082\u884c\u308f\u305a \u9054\u6210\u5024\u3092\u6c7a\u5b9a\u3059\u308b</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_17","title":"\u6226\u95d8\u6642\u80fd\u529b\uff1a\u7aae\u4f59\u4e00\u7b56","text":"<ul> <li>\u4f7f\u7528\u56de\u6570: \u6226\u95d8\u4e2d1\u56de</li> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u81ea\u8eab\u306e\u884c\u52d5\u5ba3\u8a00\u524d</li> <li>\u52b9\u679c<ul> <li>\u624b\u672d\u3082\u4e3b\u884c\u52d5\u3082\u6d88\u8cbb\u305b\u305a\u306b\u5206\u89e3\u30921\u56de\u884c\u3063\u3066\u3088\u3044\u3002\u305f\u3060\u3057\u305d\u306e\u5834\u5408\u3001\u624b\u672d\u306e\u30b9\u30fc\u30c8\u306b\u5bfe\u5fdc\u3057\u305f\u30de\u30ca\u3092\u53d7\u3051\u53d6\u308c\u306a\u3044</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_18","title":"\u4ed8\u55aa\uff08\u30ec\u30ea\u30ad\u30a2\uff09","text":"<p>\u6c38\u3044\u9593\u4f7f\u308f\u308c\u305f\u3053\u3068\u3067\u3001\u81ea\u6211\u304c\u82bd\u751f\u3048\u305f\u7a2e\u65cf\u3002\u4f55\u304b\u304c\u53d6\u308a\u6191\u3044\u305f\u308f\u3051\u3067\u306f\u306a\u3055\u305d\u3046\u3002</p> <p>\u81ea\u5206\u306e\u3053\u3068\u3092\u4e00\u756a\u5206\u304b\u3063\u3066\u3044\u308b\u306e\u306f\u81ea\u5206\u3060\u308d\u3046\u3002</p>"},{"location":"rules/ancestry/#_19","title":"\u5224\u5b9a\u6642\u80fd\u529b\uff1a\u624b\u99b4","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u53cd\u5fdc\u958b\u59cb\u524d</li> <li>\u30b3\u30b9\u30c8: \u9054\u6210\u5024\u304b\u3089\u767a\u52d5\u6642\u306e\u30c0\u30a4\u30b9\u306e\u500b\u6570\u5206\u3060\u3051\u5dee\u3057\u5f15\u304f</li> <li>\u52b9\u679c<ul> <li>\u30d7\u30fc\u30eb\u5185\u306e \u3059\u3079\u3066\u306e\u30c0\u30a4\u30b9\u3092\u632f\u308a\u76f4\u3059</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_20","title":"\u6226\u95d8\u6642\u80fd\u529b\uff1a\u7089\u706b\u7d14\u9752","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u81ea\u8eab\u306e\u624b\u756a\u306b\u60f3\u6210\u3092\u884c\u3046\u6642</li> <li>\u52b9\u679c<ul> <li>\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u4f5c\u6210\u6642\u306b\u9078\u629e\u3057\u305f\u30a2\u30a4\u30c6\u30e0\u7a2e\u306e\u60f3\u6210\u3092\u884c\u3046\u969b\u3001\u5f85\u6a5f\u5024\u30921\u8efd\u6e1b\u3059\u308b</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_21","title":"\u534a\u970a\uff08\u30a6\u30f3\u30d6\u30e9\uff09","text":"<p>\u3075\u3088\u3075\u3088\u3057\u305f\u534a\u900f\u660e\u306a\u7a2e\u65cf\u3002\u304b\u3064\u3066\u4eba\u9593\u3060\u3063\u305f\u3053\u3068\u3082\u3042\u308b\u3057\u3001\u305d\u3046\u3067\u306a\u3044\u5834\u5408\u3082\u3042\u308b\u3002</p> <p>\u4e0d\u5b89\u5b9a\u306a\u306e\u3067\u306f\u306a\u304f\u3001\u3069\u3061\u3089\u3067\u3082\u3042\u308b\u3068\u3044\u3046\u3053\u3068\u3060\u3002</p>"},{"location":"rules/ancestry/#_22","title":"\u5224\u5b9a\u6642\u80fd\u529b\uff1a\u8d8a\u5883","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u9054\u6210\u5024\u6c7a\u5b9a\u524d</li> <li>\u52b9\u679c<ul> <li>\u53cd\u5fdc\u6e08\u307f\u30c0\u30a4\u30b9\u304c\u5b58\u5728\u3057\u306a\u3044\u5834\u5408\uff1a\u6700\u7d42\u9054\u6210\u5024\u306b +1 \u3059\u308b</li> <li>\u53cd\u5fdc\u6e08\u307f\u30c0\u30a4\u30b9\u304c\u5b58\u5728\u3059\u308b\u5834\u5408\uff1a\u53cd\u5fdc\u6e08\u307f\u30c0\u30a4\u30b91\u3064\u3092 \u672a\u53cd\u5fdc \u306b\u3057\u3001\u53cd\u5fdc\u30d5\u30a7\u30fc\u30ba\u3092 \u7d9a\u884c \u3059\u308b</li> </ul> </li> </ul>"},{"location":"rules/ancestry/#_23","title":"\u6226\u95d8\u6642\u80fd\u529b\uff1a\u66d6\u6627\u6a21\u7cca","text":"<ul> <li>\u30bf\u30a4\u30df\u30f3\u30b0: \u81ea\u8eab\u306b\u5370\u8a18\u304c\u4ed8\u4e0e\u3055\u308c\u308b\u6642</li> <li>\u52b9\u679c<ul> <li>\u4ed8\u4e0e\u3055\u308c\u308b\u5370\u8a18\u306e\u5f37\u5ea6\u3092 \u00b11 \u3057\u3066\u3082\u3088\u3044</li> </ul> </li> </ul>"},{"location":"rules/dice/","title":"\u5224\u5b9a","text":"<p>\u3053\u3053\u3067\u306f\u57fa\u672c\u7684\u306a\u5224\u5b9a\u306b\u3064\u3044\u3066\u8aac\u660e\u3057\u307e\u3059\u3002\u7a2e\u65cf\u80fd\u529b\u306b\u3064\u3044\u3066\u306f \u7a2e\u65cf \u306e\u9805\u76ee\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044</p>"},{"location":"rules/dice/#_1","title":"\u6982\u8981","text":"<p>\u5224\u5b9a\u3067\u306f 1d10 \u3092\u57fa\u672c\u3068\u3057\u3001\u5fc5\u8981\u306b\u5fdc\u3058\u3066 \u5c5e\u6027\u30c0\u30a4\u30b9 \u3092\u30d7\u30fc\u30eb\u306b\u52a0\u3048\u3066\u632f\u308b\u3002</p> <p>\u51fa\u76ee\u306f \u53cd\u5fdc \u30d5\u30a7\u30fc\u30ba\u3067\u64cd\u4f5c\u3067\u304d\u3001\u6700\u7d42\u7684\u306b\u5404\u30c0\u30a4\u30b9\u3092\u63db\u7b97\u3057\u3066\u5408\u8a08\u3057\u305f\u5024\u304c \u9054\u6210\u5024 \u3068\u306a\u308b\u3002</p> <p>\u9054\u6210\u5024\u306f\u3001\u76ee\u6a19\u5024\u3068\u306e\u6bd4\u8f03\uff08\u6210\u529f/\u5931\u6557\uff09\u3084\u3001\u932c\u91d1\u306a\u3069\u4ed6\u30b7\u30b9\u30c6\u30e0\u3067\u306e\u6210\u679c\u5024\u3068\u3057\u3066\u4f7f\u308f\u308c\u308b\u3002</p>"},{"location":"rules/dice/#_2","title":"\u30c0\u30a4\u30b9\u30d7\u30fc\u30eb","text":"<p>\u30c0\u30a4\u30b9\u30d7\u30fc\u30eb\u306f\u3001\u539f\u5247 1d10 \u304b\u3089\u59cb\u3081\u3001\u5224\u5b9a\u3054\u3068\u306b\u5c5e\u6027\u30c0\u30a4\u30b9\u3092\u8ffd\u52a0\u3057\u3066\u69cb\u7bc9\u3059\u308b\u3002</p> \u5c5e\u6027 \u30c0\u30a4\u30b9 \u53cd\u5fdc\uff08\u30ad\u30fc\u30ef\u30fc\u30c9\uff09 \u53cd\u5fdc\u6761\u4ef6 \u53cd\u5fdc\u52b9\u679c \u706b d4 \u5ef6\u713c 3\u4ee5\u4e0a \u81ea\u8eab\u306e\u51fa\u76ee\u3092 4 \u306b\u3059\u308b\u3002d4\u30921\u500b\u8ffd\u52a0\u3057\u3066\u632f\u308a\u3001\u672a\u53cd\u5fdc\u3068\u3059\u308b \u571f d6 \u5909\u52d5 6 \u4ed6\u30c0\u30a4\u30b91\u500b\u306e\u51fa\u76ee\u3092 \u5faa\u74b0\u00b11 \u307e\u305f\u306f \u00b12 \u3059\u308b \u98a8 d8 \u65cb\u56de 8 \u4ed6\u30c0\u30a4\u30b91\u500b\u3092 \u534a\u56de\u8ee2 \u3059\u308b \u6c34 d20 \u6d41\u8ee2 20 \u4ed6\u30c0\u30a4\u30b91\u500b\u3092 \u632f\u308a\u76f4\u3059 \u95c7 d10 \u899a\u9192 10 \u4ed6\u30c0\u30a4\u30b91\u500b\u3092 \u88cf\u8fd4\u3059 \u5149 d12 \u6607\u83ef 12 \u4ed6\u30c0\u30a4\u30b91\u500b\u306e\u51fa\u76ee\u3092 \u6700\u5927\u5024 \u306b\u3059\u308b"},{"location":"rules/dice/#_3","title":"\u7528\u8a9e","text":"\u7528\u8a9e \u610f\u5473 \u5faa\u74b0 \u51fa\u76ee\u3092\u74b0\u72b6\u306b\u6570\u3048\u308b\u3002\u6700\u5927\u5024\u306e\u6b21\u306f 1\u30011 \u306e\u524d\u306f\u6700\u5927\u5024 \u672a\u53cd\u5fdc / \u53cd\u5fdc\u6e08\u307f \u5404\u30c0\u30a4\u30b9\u306f\u3069\u3061\u3089\u304b\u4e00\u65b9\u306e\u72b6\u614b\u3092\u6301\u3064 \u53cd\u5fdc\u53ef\u80fd \u672a\u53cd\u5fdc\u3067\u3042\u308a\u3001\u53cd\u5fdc\u6761\u4ef6\u3092\u6e80\u305f\u3057\u3066\u3044\u308b \u5faa\u74b0\u00b1k \u51fa\u76ee\u3092 k \u9032\u3081\u308b\u3001\u307e\u305f\u306f k \u623b\u3059 \u534a\u56de\u8ee2 \u9762\u6570 N \u306e\u30c0\u30a4\u30b9\u3092\u3001\u5faa\u74b0\u3067 N\u00f72 \u3060\u3051\u9032\u3081\u308b \u88cf\u8fd4\u3059 \u51fa\u76ee\u3092\u53cd\u5bfe\u5074\u306b\u3059\u308b\uff08N\uff0b1\u2212\u51fa\u76ee\uff09\u3002d4 \u306a\u3089 1\u21944\u30012\u21943 \u632f\u308a\u76f4\u3059 \u305d\u306e\u30c0\u30a4\u30b9\u3092\u3082\u3046\u4e00\u5ea6\u632f\u308a\u3001\u51fa\u76ee\u3092\u7f6e\u304d\u63db\u3048\u308b \u6fb1\u307f \u8aad\u307f\u66ff\u3048\u5f8c\u306e\u5024\u304c 1\u4ee5\u4e0b \u306e\u30c0\u30a4\u30b9\u3092 \u22121 \u3068\u3057\u3066\u6271\u3046"},{"location":"rules/dice/#_4","title":"\u5224\u5b9a\u306e\u6d41\u308c","text":""},{"location":"rules/dice/#1","title":"1. \u30c0\u30a4\u30b9\u6c7a\u5b9a","text":"<p>\u30c0\u30a4\u30b9\u30d7\u30fc\u30eb\u306b\u30c0\u30a4\u30b9\u3092\u8ffd\u52a0\u3057\u3001\u4eca\u56de\u306e\u5224\u5b9a\u3067\u632f\u308b\u30c0\u30a4\u30b9\u3092\u6c7a\u3081\u308b\u3002</p>"},{"location":"rules/dice/#2","title":"2. \u30c0\u30a4\u30b9\u30ed\u30fc\u30eb","text":"<p>\u30d7\u30fc\u30eb\u5185\u306e\u30c0\u30a4\u30b9\u3092 \u3059\u3079\u3066 \u632f\u308a\u3001\u3059\u3079\u3066 \u672a\u53cd\u5fdc \u306b\u3059\u308b\u3002</p>"},{"location":"rules/dice/#3","title":"3. \u53cd\u5fdc","text":"<p>\u53cd\u5fdc\u53ef\u80fd\u306a\u30c0\u30a4\u30b9\u304c 1\u3064\u3067\u3082\u6b8b\u3063\u3066\u3044\u308b\u9593\u3001\u6b21\u3092\u7e70\u308a\u8fd4\u3059\u3002</p> <ol> <li>\u53cd\u5fdc\u53ef\u80fd\u306a\u30c0\u30a4\u30b9\u30921\u3064\u9078\u3076</li> <li>\u305d\u306e\u30c0\u30a4\u30b9\u306e\u53cd\u5fdc\u52b9\u679c\u3092\u9069\u7528\u3059\u308b</li> <li>\u305d\u306e\u30c0\u30a4\u30b9\u3092 \u53cd\u5fdc\u6e08\u307f \u306b\u3059\u308b</li> <li>\u65b0\u305f\u306b\u53cd\u5fdc\u6761\u4ef6\u3092\u6e80\u305f\u3057\u305f\u672a\u53cd\u5fdc\u30c0\u30a4\u30b9\u304c\u3042\u308c\u3070\u3001\u53cd\u5fdc\u53ef\u80fd\u306b\u306a\u308b</li> </ol> <p>\u53cd\u5fdc\u52b9\u679c\u3067\u51fa\u76ee\u304c\u5909\u308f\u3063\u3066\u3082\u3001\u30c0\u30a4\u30b9\u306e \u672a\u53cd\u5fdc / \u53cd\u5fdc\u6e08\u307f \u306e\u72b6\u614b\u306f\u5909\u308f\u3089\u306a\u3044\u3002</p> <p>\u52b9\u679c\u306e\u5bfe\u8c61\u3092\u9078\u3076\u3068\u304d\u3001\u7279\u306b\u6307\u5b9a\u304c\u306a\u3051\u308c\u3070\u3001\u672a\u53cd\u5fdc\u30fb\u53cd\u5fdc\u6e08\u307f\u3092\u554f\u308f\u305a\u9078\u3079\u308b\u3002</p> <p>\u706b\uff08\u5ef6\u713c\uff09\u3067\u8ffd\u52a0\u3055\u308c\u305f d4 \u304c\u53cd\u5fdc\u6761\u4ef6\u3092\u6e80\u305f\u3057\u305f\u5834\u5408\u3082\u3001\u4e0a\u8a18\u3068\u540c\u69d8\u306b\u51e6\u7406\u3059\u308b\u3002</p>"},{"location":"rules/dice/#4","title":"4. \u9054\u6210\u5024\u6c7a\u5b9a","text":"<p>\u5404\u30c0\u30a4\u30b9\u306e\u5bc4\u4e0e\u306f \u6b21\u306e2\u6bb5\u968e \u3067\u6c42\u3081\u3001\u5408\u8a08\u3092 \u9054\u6210\u5024 \u3068\u3059\u308b\u3002</p>"},{"location":"rules/dice/#1_1","title":"\uff081\uff09\u51fa\u76ee\u306e\u8aad\u307f\u66ff\u3048","text":"\u30c0\u30a4\u30b9 \u63db\u7b97 \u6c34\uff08d20\uff09 \u230a\u51fa\u76ee \u00f7 2\u230b\uff08\u7aef\u6570\u5207\u308a\u6368\u3066\uff09 \u305d\u308c\u4ee5\u5916 \u51fa\u76ee\u305d\u306e\u307e\u307e"},{"location":"rules/dice/#2_1","title":"\uff082\uff09\u6fb1\u307f\u767a\u751f","text":"<p>\u8aad\u307f\u66ff\u3048\u5f8c\u306e\u5024\u304c 1\u4ee5\u4e0b \u306e\u30c0\u30a4\u30b9\u306f \u22121 \u3068\u3057\u3066\u6271\u3046\u3002</p> <p>\u6c34\uff08d20\uff09\u306e\u51fa\u76ee 2\u30fb3 \u306f\u8aad\u307f\u66ff\u3048\u5f8c\u304c 1 \u306b\u306a\u308b\u305f\u3081\u3001\u6fb1\u307f\u306e\u5bfe\u8c61\u306b\u306a\u308b\u3002</p> <p>\u76ee\u6a19\u5024\u304c\u6307\u5b9a\u3055\u308c\u3066\u3044\u308b\u3068\u304d\u3001\u9054\u6210\u5024 \u2267 \u76ee\u6a19\u5024 \u306a\u3089\u6210\u529f\u3001\u672a\u6e80\u306a\u3089\u5931\u6557\u3068\u3059\u308b\u3002</p>"},{"location":"rules/dice/#_5","title":"\u5c5e\u6027\u30c0\u30a4\u30b9\u3068\u53cd\u5fdc\u52b9\u679c","text":""},{"location":"rules/dice/#d4","title":"\u706b\uff08d4\uff09\u2014 \u5ef6\u713c","text":"<ul> <li>\u53cd\u5fdc\u6761\u4ef6: 3\u4ee5\u4e0a</li> <li>\u53cd\u5fdc\u52b9\u679c: \u81ea\u8eab\u306e\u51fa\u76ee\u3092 4 \u306b\u3059\u308b\u3002\u30c0\u30a4\u30b9\u30d7\u30fc\u30eb\u306b d4 \u30921\u500b\u8ffd\u52a0 \u3057\u3066\u632f\u308a\u3001\u305d\u308c\u3092\u672a\u53cd\u5fdc\u3068\u3057\u3066\u6271\u3046</li> </ul>"},{"location":"rules/dice/#d6","title":"\u571f\uff08d6\uff09\u2014 \u5909\u52d5","text":"<ul> <li>\u53cd\u5fdc\u6761\u4ef6: 6</li> <li>\u53cd\u5fdc\u52b9\u679c: \u81ea\u8eab\u4ee5\u5916\u306e\u30c0\u30a4\u30b91\u500b\u3092\u9078\u3073\u3001\u51fa\u76ee\u3092 \u5faa\u74b0\u00b11 \u307e\u305f\u306f \u00b12 \u3059\u308b</li> </ul>"},{"location":"rules/dice/#d8","title":"\u98a8\uff08d8\uff09\u2014 \u65cb\u56de","text":"<ul> <li>\u53cd\u5fdc\u6761\u4ef6: 8</li> <li>\u53cd\u5fdc\u52b9\u679c: \u81ea\u8eab\u4ee5\u5916\u306e\u30c0\u30a4\u30b91\u500b\u3092\u9078\u3073\u3001\u534a\u56de\u8ee2 \u3059\u308b</li> </ul>"},{"location":"rules/dice/#d20","title":"\u6c34\uff08d20\uff09\u2014 \u6d41\u8ee2","text":"<ul> <li>\u53cd\u5fdc\u6761\u4ef6: 20</li> <li>\u53cd\u5fdc\u52b9\u679c: \u81ea\u8eab\u4ee5\u5916\u306e\u30c0\u30a4\u30b91\u500b\u3092\u9078\u3073\u3001\u632f\u308a\u76f4\u3059</li> </ul>"},{"location":"rules/dice/#d10","title":"\u95c7\uff08d10\uff09\u2014 \u899a\u9192","text":"<ul> <li>\u53cd\u5fdc\u6761\u4ef6: 10</li> <li>\u53cd\u5fdc\u52b9\u679c: \u81ea\u8eab\u4ee5\u5916\u306e\u30c0\u30a4\u30b91\u500b\u3092\u9078\u3073\u3001\u88cf\u8fd4\u3059</li> </ul>"},{"location":"rules/dice/#d12","title":"\u5149\uff08d12\uff09\u2014 \u6607\u83ef","text":"<ul> <li>\u53cd\u5fdc\u6761\u4ef6: 12</li> <li>\u53cd\u5fdc\u52b9\u679c: \u81ea\u8eab\u4ee5\u5916\u306e\u30c0\u30a4\u30b91\u500b\u3092\u9078\u3073\u3001\u51fa\u76ee\u3092 \u6700\u5927\u5024 \u306b\u3059\u308b</li> </ul>"},{"location":"rules/dice/#_6","title":"\u4f8b","text":"<p>\u30d7\u30fc\u30eb: d10\uff1d6\u3001d6\uff1d6\u3001d8\uff1d3\uff08\u76ee\u6a19\u5024 10\uff09</p> <ol> <li>\u30ed\u30fc\u30eb \u2014 \u3059\u3079\u3066\u672a\u53cd\u5fdc</li> <li>\u53cd\u5fdc \u2014 d6 \u304c6\u306a\u306e\u3067\u53cd\u5fdc\u53ef\u80fd\u3002\u5909\u52d5 \u3067 d10 \u3092\u5faa\u74b0\uff0b2 \u2192 d10\uff1d8\u3002d6 \u3092\u53cd\u5fdc\u6e08\u307f\u306b\u3059\u308b</li> <li>\u53cd\u5fdc\u7d42\u4e86 \u2014 d8 \u306f\u6761\u4ef6\u672a\u9054\u3002\u53cd\u5fdc\u53ef\u80fd\u306a\u30c0\u30a4\u30b9\u304c\u306a\u304f\u306a\u308b</li> <li>\u9054\u6210\u5024\u6c7a\u5b9a \u2014 \u8aad\u307f\u66ff\u3048\u5f8c d10\uff1d8\u3001d6\uff1d6\u3001d8\uff1d3\u3002\u6fb1\u307f\u306a\u3057 \u2192 \u5408\u8a08 17 \u2192 \u6210\u529f</li> </ol>"}]}